{
  "name": "opendoor-plugin",
  "version": "0.4.0",
  "description": "Opendoor — a pi-web browser plugin that surfaces Doorstop requirements stored in the workspace: the document tree, per-item state (reviewed/unreviewed changes, suspect links), validation findings, and one-click doorstop CLI actions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kairibu/opendoor.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-web",
    "plugin",
    "pi-web.dev-plugin",
    "pi-web-plugin",
    "doorstop",
    "requirements"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-extension/index.js"
    ]
  },
  "piWeb": {
    "plugins": [
      {
        "id": "opendoor",
        "browserRoot": "dist/browser",
        "module": "dist/browser/pi-web-plugin.js",
        "serverModule": "dist/server-plugin.js"
      }
    ]
  },
  "files": [
    "dist"
  ],
  "main": "dist/browser/pi-web-plugin.js",
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "dev": "node scripts/build-plugin.mjs --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@jmfederico/pi-web": ">=1.202609.1"
  },
  "devDependencies": {
    "@jmfederico/pi-web": "1.202610.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.27.7",
    "happy-dom": "^20.14.6",
    "js-yaml": "^4.3.2",
    "lit": "^3.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
