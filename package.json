{
  "name": "opendoor-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Opendoor — a pi-web browser plugin that surfaces Doorstop requirements stored in the workspace: the document tree, per-item state (reviewed/unreviewed changes, suspect links), validation findings, and one-click doorstop CLI actions.",
  "type": "module",
  "piWeb": {
    "plugins": [
      {
        "id": "opendoor",
        "browserRoot": ".",
        "module": "pi-web-plugin.js"
      }
    ]
  },
  "files": [
    "dist"
  ],
  "main": "dist/pi-web-plugin.js",
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "dev": "node scripts/build-plugin.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@jmfederico/pi-web": ">=1.202608"
  },
  "devDependencies": {
    "@jmfederico/pi-web": "^1.202608.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.7",
    "happy-dom": "^20.11.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
